PORT=5000

MONGODB_URI=your_mongodb_connection_string

JWT_SECRET=your_long_random_secret

ADMIN_EMAIL=your_admin_email

ADMIN_PASSWORD=your_admin_password

FRONTEND_URL=https://your-deployed-frontend.example.com

# Gmail address the notification emails are sent from
EMAIL_USER=your_gmail_address@gmail.com
# Gmail App Password (not your regular password) — https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your_16_char_app_password
# Comma-separated list of parent email addresses to notify
PARENT_EMAILS=parent1@example.com,parent2@example.com
